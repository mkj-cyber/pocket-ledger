{
  "name": "Pocket Ledger",
  "short_name": "Pocket Ledger",
  "description": "Log spending and money lent to friends in seconds. Works offline and backs up to your Google Sheet.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#111613",
  "theme_color": "#111613",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Log amount", "short_name": "Log amount", "description": "What is the amount?", "url": "./?go=add", "icons": [{ "src": "sc-log.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Quick entry", "short_name": "Quick entry", "description": "Every detail on one screen", "url": "./?go=quick", "icons": [{ "src": "sc-quick.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Lend money", "short_name": "Lend money", "description": "Record a loan or payback", "url": "./?go=lent", "icons": [{ "src": "sc-lent.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "This week", "short_name": "This week", "description": "See this week's spending", "url": "./?go=week", "icons": [{ "src": "sc-week.png", "sizes": "96x96", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
